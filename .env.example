# Ejemplo de archivo .env para desarrollo local
# Copia este archivo a .env y personaliza los valores según tu entorno

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost,http://127.0.0.1

# Ejemplo de otras variables de entorno que podrías necesitar:
DATABASE_URL=sqlite:///./castZone.db
